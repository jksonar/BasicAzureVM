# Copy this file to terraform.tfvars and adjust values before running `terraform apply`.

prefix      = "basicvm"
environment = "dev"
location    = "eastus"

vnet_address_space      = ["10.0.0.0/16"]
subnet_address_prefixes = ["10.0.1.0/24"]

admin_username = "azureuser"
vm_size        = "Standard_D2als_v7"
vm_count       = 1

# IMPORTANT: restrict SSH access to your own IP/CIDR, not "*".
# Find your IP with: curl -s ifconfig.me
nsg_rules = {
  AllowSSH = {
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = "YOUR.IP.ADDRESS.HERE/32"
    destination_address_prefix = "*"
  }
}

tags = {
  owner = "ext_jsonar"
}
